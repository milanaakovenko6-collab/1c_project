// ПЕЧАТЬ ДОКУМЕНТА
// ==========================================
&НаКлиенте
Процедура Печать(Команда)
	ТабДок = СформироватьПечатьНаСервере();
	ТабДок.Показать("Производственный выпуск");
КонецПроцедуры

&НаСервере
Функция СформироватьПечатьНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Истина;
	
	// Настраиваем ширину колонок
	ТабДок.Область("C1").ШиринаКолонки = 35;
	ТабДок.Область("C2").ШиринаКолонки = 15;
	ТабДок.Область("C3").ШиринаКолонки = 15;
	
	// 1. ЗАГОЛОВОК
	ТабДок.Область("R1C1:R1C3").Объединить();
	ТабДок.Область("R1C1").Текст = "Производственный выпуск № " + Объект.Номер;
	ТабДок.Область("R1C1").Шрифт = Новый Шрифт(, 14, Истина);
	
	ТабДок.Область("R2C1").Текст = "Дата: " + Формат(Объект.Дата, "ДЛФ=DD");
	ТабДок.Область("R3C1").Текст = "Цех: " + Объект.Цех;
	
	// 2. ТАБЛИЦА ПРОДУКЦИИ
	ТабДок.Область("R5C1").Текст = "Выпущенная продукция";
	ТабДок.Область("R5C1").Шрифт = Новый Шрифт(, 12, Истина);
	
	ТабДок.Область("R6C1").Текст = "Номенклатура";
	ТабДок.Область("R6C2").Текст = "Количество";
	ТабДок.Область("R6C3").Текст = "Себестоимость";
	
	// Оформление шапки таблицы
	Для Кол = 1 По 3 Цикл
		Ячейка = ТабДок.Область("R6C" + Кол);
		Ячейка.Шрифт = Новый Шрифт(, 10, Истина);
		Ячейка.ЦветФона = WebЦвета.СветлоСерый;
		Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	КонецЦикла;
	
	НомерСтроки = 7;
	Для Каждого СтрокаПродукции Из Объект.Продукция Цикл
		ТабДок.Область("R" + НомерСтроки + "C1").Текст = СтрокаПродукции.Номенклатура;
		ТабДок.Область("R" + НомерСтроки + "C2").Текст = СтрокаПродукции.Количество;
		ТабДок.Область("R" + НомерСтроки + "C3").Текст = СтрокаПродукции.Себестоимость;
		
		ТабДок.Область("R" + НомерСтроки + "C2").ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		ТабДок.Область("R" + НомерСтроки + "C3").ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	// 3. ТАБЛИЦА МАТЕРИАЛОВ
	НомерСтроки = НомерСтроки + 1; // Пропуск строки
	ТабДок.Область("R" + НомерСтроки + "C1").Текст = "Использованные материалы";
	ТабДок.Область("R" + НомерСтроки + "C1").Шрифт = Новый Шрифт(, 12, Истина);
	НомерСтроки = НомерСтроки + 1;
	
	ТабДок.Область("R" + НомерСтроки + "C1").Текст = "Номенклатура";
	ТабДок.Область("R" + НомерСтроки + "C2").Текст = "Количество";
	
	Для Кол = 1 По 2 Цикл
		Ячейка = ТабДок.Область("R" + НомерСтроки + "C" + Кол);
		Ячейка.Шрифт = Новый Шрифт(, 10, Истина);
		Ячейка.ЦветФона = WebЦвета.СветлоСерый;
		Ячейка.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	КонецЦикла;
	
	НомерСтроки = НомерСтроки + 1;
	Для Каждого СтрокаМатериала Из Объект.Материалы Цикл
		ТабДок.Область("R" + НомерСтроки + "C1").Текст = СтрокаМатериала.Номенклатура;
		ТабДок.Область("R" + НомерСтроки + "C2").Текст = СтрокаМатериала.Количество;
		
		ТабДок.Область("R" + НомерСтроки + "C2").ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
		
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат ТабДок;
КонецФункции
