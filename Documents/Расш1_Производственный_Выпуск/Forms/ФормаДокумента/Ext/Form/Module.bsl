// ==========================================
// АВТОЗАПОЛНЕНИЕ МАТЕРИАЛОВ ПО СПЕЦИФИКАЦИИ (FIFO)
// ==========================================
&НаКлиенте
Процедура ПродукцияКоличествоПриИзменении(Элемент)
	ЗаполнитьМатериалыНаСервере();
	Строка = Элементы.Продукция.ТекущиеДанные;
	Если Строка <> Неопределено И ЗначениеЗаполнено(Строка.Номенклатура) Тогда
		// Передаем текущий Цех, чтобы знать, откуда списывать
		Строка.Себестоимость = РассчитатьСебестоимостьНаСервере(Строка.Номенклатура, Строка.Количество, Объект.Цех);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция РассчитатьСебестоимостьНаСервере(Номенклатура, Количество, ТекущийЦех)
	Если НЕ ЗначениеЗаполнено(ТекущийЦех) Тогда Возврат 0; КонецЕсли;
	
	ЗапросРецепт = Новый Запрос;
	ЗапросРецепт.Текст = 
		"ВЫБРАТЬ
		|	Материалы.Номенклатура КАК Сырье,
		|	Материалы.Количество КАК Норма
		|ИЗ
		|	Справочник.Расш1_Спецификация.Материалы КАК Материалы
		|ГДЕ
		|	Материалы.Ссылка.Продукция = &Продукция";
	ЗапросРецепт.УстановитьПараметр("Продукция", Номенклатура);
	ВыборкаРецепт = ЗапросРецепт.Выполнить().Выбрать();
	
	ОбщаяСтоимость = 0;
	
	Пока ВыборкаРецепт.Следующий() Цикл
		Требуется = ВыборкаРецепт.Норма * Количество;
		
		// Ищем остатки для этого сырья в цехе (как в модуле объекта)
		ЗапросОстатки = Новый Запрос;
		ЗапросОстатки.Текст = 
			"ВЫБРАТЬ
			|	Остатки.Партия КАК Партия,
			|	Остатки.КоличествоОстаток КАК Ост
			|ИЗ
			|	РегистрНакопления.Расш1_Остатки_товаров.Остатки(, Склад = &Склад И Номенклатура = &Ном) КАК Остатки
			|ГДЕ
			|	Остатки.КоличествоОстаток > 0
			|УПОРЯДОЧИТЬ ПО
			|	Остатки.Партия.Дата ВОЗР";
		ЗапросОстатки.УстановитьПараметр("Склад", ТекущийЦех); 
		ЗапросОстатки.УстановитьПараметр("Ном", ВыборкаРецепт.Сырье);
		
		ВыборкаОстатки = ЗапросОстатки.Выполнить().Выбрать();
		ОсталосьНайти = Требуется;
		
		Пока ВыборкаОстатки.Следующий() И ОсталосьНайти > 0 Цикл
			Взять = Мин(ВыборкаОстатки.Ост, ОсталосьНайти);
			ПартияМатериала = ВыборкаОстатки.Партия;
			ЦенаСырья = 0;
			
			// Если партия - это ПРИХОД (гранулы)
			Если ТипЗнч(ПартияМатериала) = Тип("ДокументСсылка.Расш1_Приход_Товара") Тогда
				ЗапросЦена = Новый Запрос;
				ЗапросЦена.Текст = "ВЫБРАТЬ Цена КАК Цена ИЗ Документ.Расш1_Приход_Товара.Материалы ГДЕ Ссылка = &Партия И Номенклатура = &Ном";
				ЗапросЦена.УстановитьПараметр("Партия", ПартияМатериала);
				ЗапросЦена.УстановитьПараметр("Ном", ВыборкаРецепт.Сырье);
				ВыборкаЦены = ЗапросЦена.Выполнить().Выбрать();
				Если ВыборкаЦены.Следующий() Тогда
					ЦенаСырья = ВыборкаЦены.Цена;
				КонецЕсли;
				
			// Если партия - это ВЫПУСК (полуфабрикат)
			ИначеЕсли ТипЗнч(ПартияМатериала) = Тип("ДокументСсылка.Расш1_Производственный_Выпуск") Тогда
				// Берем общую себестоимость и делим на количество в той партии
				ЗапросСебестоимость = Новый Запрос;
				ЗапросСебестоимость.Текст = "ВЫБРАТЬ Себестоимость, Количество ИЗ Документ.Расш1_Производственный_Выпуск.Продукция ГДЕ Ссылка = &Партия И Номенклатура = &Ном";
				ЗапросСебестоимость.УстановитьПараметр("Партия", ПартияМатериала);
				ЗапросСебестоимость.УстановитьПараметр("Ном", ВыборкаРецепт.Сырье);
				ВыборкаСебестоимости = ЗапросСебестоимость.Выполнить().Выбрать();
				Если ВыборкаСебестоимости.Следующий() И ВыборкаСебестоимости.Количество > 0 Тогда
					ЦенаСырья = ВыборкаСебестоимости.Себестоимость / ВыборкаСебестоимости.Количество; // Цена за 1 ед.
				КонецЕсли;
			КонецЕсли;
			
			ОбщаяСтоимость = ОбщаяСтоимость + (Взять * ЦенаСырья);
			ОсталосьНайти = ОсталосьНайти - Взять;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ОбщаяСтоимость;
КонецФункции

&НаКлиенте
Процедура ЗаполнитьМатериалыПоСпецификации()
	ЗаполнитьМатериалыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМатериалыНаСервере()
	Объект.Материалы.Очистить();
	
	Для Каждого СтрокаПродукции Из Объект.Продукция Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаПродукции.Номенклатура) ИЛИ СтрокаПродукции.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Если спецификация не выбрана - берем первую попавшуюся (для обратной совместимости)
		Спецификация = СтрокаПродукции.Спецификация;
		Если НЕ ЗначениеЗаполнено(Спецификация) Тогда
			ЗапросСпец = Новый Запрос;
			ЗапросСпец.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Расш1_Спецификация ГДЕ Продукция = &Продукция";
			ЗапросСпец.УстановитьПараметр("Продукция", СтрокаПродукции.Номенклатура);
			ВыборкаСпец = ЗапросСпец.Выполнить().Выбрать();
			Если ВыборкаСпец.Следующий() Тогда
				Спецификация = ВыборкаСпец.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Спецификация) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	Материалы.Номенклатура КАК Сырье,
				|	Материалы.Количество КАК Норма
				|ИЗ
				|	Справочник.Расш1_Спецификация.Материалы КАК Материалы
				|ГДЕ
				|	Материалы.Ссылка = &Спецификация"; // Ищем по конкретной спецификации!
			Запрос.УстановитьПараметр("Спецификация", Спецификация);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				Требуется = Выборка.Норма * СтрокаПродукции.Количество;
				РаспределитьПоПартиям(Объект.Цех, Выборка.Сырье, Требуется);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
&НаСервере
Процедура РаспределитьПоПартиям(ТекущийЦех, Номенклатура, Требуется)
	Если НЕ ЗначениеЗаполнено(ТекущийЦех) Тогда
		Нов = Объект.Материалы.Добавить();
		Нов.Номенклатура = Номенклатура;
		Нов.Количество = Требуется;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Остатки.Партия КАК Партия,
		|	Остатки.КоличествоОстаток КАК Ост
		|ИЗ
		|	РегистрНакопления.Расш1_Остатки_товаров.Остатки(, Склад = &Склад И Номенклатура = &Ном) КАК Остатки
		|ГДЕ
		|	Остатки.КоличествоОстаток > 0
		|УПОРЯДОЧИТЬ ПО
		|	Остатки.Партия.Дата ВОЗР";
	Запрос.УстановитьПараметр("Склад", ТекущийЦех);
	Запрос.УстановитьПараметр("Ном", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ОсталосьНайти = Требуется;
	
	Пока Выборка.Следующий() И ОсталосьНайти > 0 Цикл
		Взять = Мин(Выборка.Ост, ОсталосьНайти);
		Нов = Объект.Материалы.Добавить();
		Нов.Номенклатура = Номенклатура;
		Нов.Количество = Взять;
		Нов.Партия = Выборка.Партия;
		ОсталосьНайти = ОсталосьНайти - Взять;
	КонецЦикла;
	
	Если ОсталосьНайти > 0 Тогда
		Нов = Объект.Материалы.Добавить();
		Нов.Номенклатура = Номенклатура;
		Нов.Количество = ОсталосьНайти;
		Сообщить("В цехе не хватает: " + Номенклатура + " в кол-ве " + ОсталосьНайти);
	КонецЕсли;
КонецПроцедуры

