Процедура ОбработкаПроведения(Отказ, Режим)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Материалы.Номенклатура КАК Номенклатура,
		|	СУММА(Материалы.Количество) КАК КоличествоТребуется
		|ПОМЕСТИТЬ ВТ_ТоварыДокумента
		|ИЗ
		|	Документ.Расш1_Производственный_Выпуск.Материалы КАК Материалы
		|ГДЕ 	
		|	Материалы.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО 
		|	Материалы.Номенклатура
		|;
		|
		|ВЫБРАТЬ
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Партия КАК Партия,
		|	Остатки.КоличествоОстаток КАК Количество,
		|	ВЫБОР
		|		КОГДА Остатки.Партия ССЫЛКА Документ.Расш1_Приход_Товара ТОГДА ПриходДок.Дата
		|		КОГДА Остатки.Партия ССЫЛКА Документ.Расш1_Производственный_Выпуск ТОГДА ВыпускДок.Дата
		|		ИНАЧЕ ДАТАВРЕМЯ(1,1,1)
		|	КОНЕЦ КАК ДатаПартии
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	РегистрНакопления.Расш1_Остатки_товаров.Остатки(
		|		&МоментВремени, 
		|		Склад = &Цех
		|			И Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ВТ_ТоварыДокумента)
		|	) КАК Остатки 
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Расш1_Приход_Товара КАК ПриходДок
		|		ПО Остатки.Партия = ПриходДок.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Расш1_Производственный_Выпуск КАК ВыпускДок
		|		ПО Остатки.Партия = ВыпускДок.Ссылка
		|ГДЕ 
		|	Остатки.КоличествоОстаток > 0
		|;
		|
		|ВЫБРАТЬ
		|	ВТ.Номенклатура КАК Номенклатура,
		|	Спр.Наименование КАК ИмяТовара,
		|	ВТ.КоличествоТребуется, 
		|	ЕСТЬNULL(СУММА(Ост.Количество), 0) КАК ОбщийОстаток,
		|	ВЫБОР
		|		КОГДА ВТ.КоличествоТребуется > ЕСТЬNULL(СУММА(Ост.Количество), 0)
		|			ТОГДА ВТ.КоличествоТребуется - ЕСТЬNULL(СУММА(Ост.Количество), 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Недостаток
		|ИЗ 
		|	ВТ_ТоварыДокумента КАК ВТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Расш1_Номенклатура КАК Спр
		|		ПО ВТ.Номенклатура = Спр.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК Ост
		|		ПО ВТ.Номенклатура = Ост.Номенклатура
		|СГРУППИРОВАТЬ ПО 
		|	ВТ.Номенклатура,
		|	Спр.Наименование,
		|	ВТ.КоличествоТребуется
		|ИМЕЮЩИЕ
		|	ВТ.КоличествоТребуется > ЕСТЬNULL(СУММА(Ост.Количество), 0)
		|;
		|
		|ВЫБРАТЬ
		|	ВТ_Остатки.Номенклатура КАК Номенклатура,
		|	ВТ_Остатки.Партия КАК Партия,
		|	ВТ_Остатки.Количество КАК Количество
		|ИЗ
		|	ВТ_Остатки КАК ВТ_Остатки
		|УПОРЯДОЧИТЬ ПО
		|	ВТ_Остатки.ДатаПартии ВОЗР
		|;
		|
		|ВЫБРАТЬ
		|	Номенклатура,
		|	КоличествоТребуется
		|ИЗ
		|	ВТ_ТоварыДокумента";
			
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Цех", Цех);
	
	РезультатПакета = Запрос.ВыполнитьПакет();
	
	ВыборкаНедостач = РезультатПакета[2].Выбрать();
	Пока ВыборкаНедостач.Следующий() Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Недостаточно товара: " + ВыборкаНедостач.ИмяТовара + 
						  " в цехе. Не хватает: " + ВыборкаНедостач.Недостаток;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Материалы.Очистить();

	ТаблицаОстатков = РезультатПакета[3].Выгрузить();
	
	ВыборкаТребований = РезультатПакета[4].Выбрать();
	Пока ВыборкаТребований.Следующий() Цикл
		РаспределитьПоПартиям(Цех, ВыборкаТребований.Номенклатура,
		ВыборкаТребований.КоличествоТребуется, Отказ, ТаблицаОстатков);
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.Расш1_Остатки_товаров.Записывать = Истина;
	Движения.Расш1_Движения_Товаров.Записывать = Истина;
	
	Для Каждого СтрокаГП Из Продукция Цикл
		Дв = Движения.Расш1_Остатки_товаров.Добавить();
		Дв.ВидДвижения = ВидДвиженияНакопления.Приход;
		Дв.Период = Дата;
		Дв.Номенклатура = СтрокаГП.Номенклатура;
		Дв.Склад = Цех;
		Дв.Партия = Ссылка;
		Дв.Количество = СтрокаГП.Количество;
		
		ДвТ = Движения.Расш1_Движения_Товаров.Добавить();
		ДвТ.Период = Дата;
		ДвТ.Номенклатура = СтрокаГП.Номенклатура;
		ДвТ.Склад = Цех;
		ДвТ.Операция = Перечисления.Расш1_Виды_Операций.Выпуск;
		ДвТ.Количество = СтрокаГП.Количество;
	КонецЦикла;
	
	Для Каждого СтрокаМатериала Из Материалы Цикл
		Дв = Движения.Расш1_Остатки_товаров.Добавить();
		Дв.ВидДвижения = ВидДвиженияНакопления.Расход;
		Дв.Период = Дата;
		Дв.Номенклатура = СтрокаМатериала.Номенклатура;
		Дв.Склад = Цех;
		Дв.Партия = СтрокаМатериала.Партия;
		Дв.Количество = СтрокаМатериала.Количество;
		
		ДвТ = Движения.Расш1_Движения_Товаров.Добавить();
		ДвТ.Период = Дата;
		ДвТ.Номенклатура = СтрокаМатериала.Номенклатура;
		ДвТ.Склад = Цех;
		ДвТ.Операция = Перечисления.Расш1_Виды_Операций.Расход;
		ДвТ.Количество = СтрокаМатериала.Количество;
	КонецЦикла;
	
	Движения.Записать();
	
	Для Каждого СтрокаГП Из Продукция Цикл
    	СтрокаГП.Партия = Ссылка; 
	КонецЦикла;
	
	Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

Процедура РаспределитьПоПартиям(ТекущийЦех, Номенклатура, Требуется, Отказ, ТаблицаОстатков)
	Если НЕ ЗначениеЗаполнено(ТекущийЦех) Тогда
		Возврат;
	КонецЕсли;
	
	ОсталосьНайти = Требуется;

	Отбор = Новый Структура("Номенклатура", Номенклатура);
	НайденныеПартии = ТаблицаОстатков.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаОстатка Из НайденныеПартии Цикл
		Если ОсталосьНайти <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		Взять = Мин(СтрокаОстатка.Количество, ОсталосьНайти);
		
		Нов = Материалы.Добавить();
		Нов.Номенклатура = Номенклатура;
		Нов.Количество = Взять;
		Нов.Партия = СтрокаОстатка.Партия;
		
		ОсталосьНайти = ОсталосьНайти - Взять;
	КонецЦикла;
	
	Если ОсталосьНайти > 0 Тогда
		Нов = Материалы.Добавить();
		Нов.Номенклатура = Номенклатура;
		Нов.Количество = ОсталосьНайти;
		Отказ = Истина; 
	КонецЕсли;
КонецПроцедуры