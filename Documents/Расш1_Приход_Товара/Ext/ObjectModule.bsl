Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	// Считаем итоговую сумму по документу
	ИтоговаяСумма = 0;
	Для Каждого СтрокаТЧ Из Материалы Цикл
		Если ЗначениеЗаполнено(СтрокаТЧ.Сумма) Тогда
			ИтоговаяСумма = ИтоговаяСумма + СтрокаТЧ.Сумма;
		КонецЕсли;
	КонецЦикла; 
	
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.Расш1_Остатки_товаров.Записывать = Истина;
	Движения.Расш1_Движения_Товаров.Записывать = Истина;
	
	Для Каждого СтрокаТЧ Из Материалы Цикл
		// Партия для прихода - это сам документ
		СтрокаТЧ.Партия = Ссылка; 
		
		ДвижениеОстатки = Движения.Расш1_Остатки_товаров.Добавить();
		ДвижениеОстатки.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеОстатки.Период = Дата;
		ДвижениеОстатки.Номенклатура = СтрокаТЧ.Номенклатура;
		ДвижениеОстатки.Склад = Склад;
		ДвижениеОстатки.Партия = Ссылка;
		ДвижениеОстатки.Количество = СтрокаТЧ.Количество;
		
		ДвижениеТоваров = Движения.Расш1_Движения_Товаров.Добавить();
		ДвижениеТоваров.Период = Дата;
		ДвижениеТоваров.Номенклатура = СтрокаТЧ.Номенклатура;
		ДвижениеТоваров.Склад = Склад;
		ДвижениеТоваров.Операция = Перечисления.Расш1_Виды_Операций.Приход;
		ДвижениеТоваров.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	Движения.Записать();
КонецПроцедуры