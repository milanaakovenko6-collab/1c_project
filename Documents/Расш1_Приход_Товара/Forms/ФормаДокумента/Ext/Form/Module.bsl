// ==========================================
// АВТОРАСЧЕТ СУММ (СТРОКИ И ИТОГА)
// ==========================================
&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)
	ПересчитатьСумму();
КонецПроцедуры

&НаКлиенте
Процедура МатериалыЦенаПриИзменении(Элемент)
	ПересчитатьСумму();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСумму()
	Строка = Элементы.Материалы.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		Строка.Сумма = Строка.Количество * Строка.Цена;
		ПересчитатьИтог();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтог()
	ОбщаяСумма = 0;
	Для Каждого Стр Из Объект.Материалы Цикл
		Если ЗначениеЗаполнено(Стр.Сумма) Тогда
			ОбщаяСумма = ОбщаяСумма + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;
	Объект.ИтоговаяСумма = ОбщаяСумма;
КонецПроцедуры

// ==========================================
// ФИЛЬТР НОМЕНКЛАТУРЫ (Только Сырье и Полуфабрикаты)
// ==========================================
&НаКлиенте
Процедура МатериалыНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораНоменклатурыСырья", ЭтотОбъект);
	ПараметрыФормы = Новый Структура("Отбор", ПолучитьОтборПоСырью());
	ОткрытьФорму("Справочник.Расш1_Номенклатура.ФормаВыбора", ПараметрыФормы, ЭтаФорма, , , , Оповещение);
КонецПроцедуры

&НаСервере
Функция ПолучитьОтборПоСырью()
	Отбор = Новый Структура;
	СписокВидов = Новый Массив;
	СписокВидов.Добавить(Перечисления.Расш1_Виды_Номенклатуры.Сырье);
	СписокВидов.Добавить(Перечисления.Расш1_Виды_Номенклатуры.Полуфабрикат);
	Отбор.Вставить("Вид", СписокВидов);
	Возврат Отбор;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораНоменклатурыСырья(ВыбранныйТовар, ДопПараметры) Экспорт
	Если ВыбранныйТовар <> Неопределено Тогда
		Строка = Элементы.Материалы.ТекущиеДанные;
		Если Строка <> Неопределено Тогда
			Строка.Номенклатура = ВыбранныйТовар;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ==========================================
// ПЕЧАТЬ
// ==========================================

&НаСервере
Функция СформироватьПечатьНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Истина;
	
	ТабДок.Область("C1").ШиринаКолонки = 30; ТабДок.Область("C2").ШиринаКолонки = 15;
	ТабДок.Область("C3").ШиринаКолонки = 15; ТабДок.Область("C4").ШиринаКолонки = 15;
	
	ТабДок.Область("R1C1:R1C4").Объединить();
	ТабДок.Область("R1C1").Текст = "Приходная накладная № " + Объект.Номер;
	ТабДок.Область("R1C1").Шрифт = Новый Шрифт(, 12, Истина);
	
	ТабДок.Область("R2C1").Текст = "Дата: " + Формат(Объект.Дата, "ДЛФ=DD");
	ТабДок.Область("R3C1").Текст = "Поставщик: " + Объект.Поставщик;
	
	ТабДок.Область("R5C1").Текст = "Товар"; ТабДок.Область("R5C2").Текст = "Кол-во";
	ТабДок.Область("R5C3").Текст = "Цена"; ТабДок.Область("R5C4").Текст = "Сумма";
	ТабДок.Область("R5C1:R5C4").Шрифт = Новый Шрифт(, 10, Истина);
	ТабДок.Область("R5C1:R5C4").ЦветФона = WebЦвета.СветлоСерый;
	
	НомерСтроки = 6;
	Для Каждого СтрокаТЧ Из Объект.Материалы Цикл
		ТабДок.Область("R" + НомерСтроки + "C1").Текст = СтрокаТЧ.Номенклатура;
		ТабДок.Область("R" + НомерСтроки + "C2").Текст = СтрокаТЧ.Количество;
		ТабДок.Область("R" + НомерСтроки + "C3").Текст = СтрокаТЧ.Цена;
		ТабДок.Область("R" + НомерСтроки + "C4").Текст = СтрокаТЧ.Сумма;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	НомерСтроки = НомерСтроки + 1;
	ТабДок.Область("R" + НомерСтроки + "C1").Текст = "Итого:";
	ТабДок.Область("R" + НомерСтроки + "C4").Текст = Объект.ИтоговаяСумма;
	Возврат ТабДок;
КонецФункции

&НаКлиенте
Процедура Печать(Команда)
	ТабДок = СформироватьПечатьНаСервере();
	ТабДок.Показать("Приходная накладная");
КонецПроцедуры
