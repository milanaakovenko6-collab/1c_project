// ==========================================
// ВЫБОР ПАРТИИ И РАСЧЕТ ЦЕНЫ
// ==========================================

&НаСервере
Функция ПолучитьПартииДляВыбора(Склад, Номенклатура)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Остатки.Партия КАК Партия ИЗ РегистрНакопления.Расш1_Остатки_товаров.Остатки(, Склад = &Склад И Номенклатура = &Ном) КАК Остатки ГДЕ Остатки.КоличествоОстаток > 0";
	Запрос.УстановитьПараметр("Склад", Склад); Запрос.УстановитьПараметр("Ном", Номенклатура);
	Массив = Новый Массив; Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл Массив.Добавить(Выборка.Партия); КонецЦикла;
	Возврат Массив;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораПартииТовары(ВыбраннаяПартия, ДопПараметры) Экспорт
	Если ВыбраннаяПартия <> Неопределено Тогда
		Строка = Элементы.Товары.ТекущиеДанные;
		Если Строка <> Неопределено Тогда 
			Строка.Партия = ВыбраннаяПартия; 
			// ВЫЗЫВАЕМ РАСЧЕТ СРАЗУ ПОСЛЕ ВЫБОРА
			ТоварыПартияПриИзменении(Неопределено);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПартияПриИзменении(Элемент)
	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка <> Неопределено И ЗначениеЗаполнено(Строка.Партия) Тогда
		Себест = ПолучитьСебестоимость(Строка.Партия, Строка.Номенклатура);
		Строка.Цена = Окр(Себест * 1.2, 2);
		
		Если ЗначениеЗаполнено(Строка.Количество) Тогда
			Строка.Сумма = Строка.Количество * Строка.Цена;
		КонецЕсли;
		ПересчитатьИтог();
	КонецЕсли;
КонецПроцедуры

// ==========================================
// ПЕРЕСЧЕТ СУММЫ И ИТОГА
// ==========================================
&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		Строка.Сумма = Строка.Количество * Строка.Цена;
		ПересчитатьИтог();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	Строка = Элементы.Товары.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		Строка.Сумма = Строка.Количество * Строка.Цена;
		ПересчитатьИтог();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтог()
	Итог = 0;
	Для Каждого Стр Из Объект.Товары Цикл
		Если ЗначениеЗаполнено(Стр.Сумма) Тогда
			Итог = Итог + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;
	Объект.ИтоговаяСумма = Итог;
КонецПроцедуры

&НаСервере
Функция ПолучитьСебестоимость(Партия, Номенклатура)
	Если ТипЗнч(Партия) = Тип("ДокументСсылка.Расш1_Производственный_Выпуск") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Продукция.Себестоимость КАК Себестоимость,
			|	Продукция.Количество КАК Количество
			|ИЗ
			|	Документ.Расш1_Производственный_Выпуск.Продукция КАК Продукция
			|ГДЕ
			|	Продукция.Ссылка = &Партия
			|	И Продукция.Номенклатура = &Номенклатура";
		Запрос.УстановитьПараметр("Партия", Партия);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() И Выборка.Количество > 0 Тогда
			Возврат Выборка.Себестоимость / Выборка.Количество;
		КонецЕсли;
	КонецЕсли;
	Возврат 0;
КонецФункции

// ==========================================
// ФИЛЬТР НОМЕНКЛАТУРЫ (Только Готовая продукция)
// ==========================================
&НаКлиенте
Процедура ТоварыНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораНоменклатурыГП", ЭтотОбъект);
	ПараметрыФормы = Новый Структура("Отбор", ПолучитьОтборПоГП());
	ОткрытьФорму("Справочник.Расш1_Номенклатура.ФормаВыбора", ПараметрыФормы, ЭтаФорма, , , , Оповещение);
КонецПроцедуры

&НаСервере
Функция ПолучитьОтборПоГП()
	Отбор = Новый Структура;
	СписокВидов = Новый Массив;
	СписокВидов.Добавить(Перечисления.Расш1_Виды_Номенклатуры.ГотоваяПродукция);
	Отбор.Вставить("Вид", СписокВидов);
	Возврат Отбор;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораНоменклатурыГП(ВыбранныйТовар, ДопПараметры) Экспорт
	Если ВыбранныйТовар <> Неопределено Тогда
		Строка = Элементы.Товары.ТекущиеДанные;
		Если Строка <> Неопределено Тогда Строка.Номенклатура = ВыбранныйТовар; КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ==========================================
// ПЕЧАТЬ (оставляем как было)
// ==========================================
&НаКлиенте
Процедура Печать(Команда)
	ТабДок = СформироватьПечатьНаСервере();
	ТабДок.Показать("Реализация товаров");
КонецПроцедуры

&НаСервере
Функция СформироватьПечатьНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Истина;
	ТабДок.Область("C1").ШиринаКолонки = 30; ТабДок.Область("C2").ШиринаКолонки = 15;
	ТабДок.Область("C3").ШиринаКолонки = 15; ТабДок.Область("C4").ШиринаКолонки = 15;
	ТабДок.Область("R1C1:R1C4").Объединить();
	ТабДок.Область("R1C1").Текст = "Реализация товаров № " + Объект.Номер;
	ТабДок.Область("R1C1").Шрифт = Новый Шрифт(, 12, Истина);
	ТабДок.Область("R2C1").Текст = "Дата: " + Формат(Объект.Дата, "ДЛФ=DD");
	ТабДок.Область("R3C1").Текст = "Клиент: " + Объект.Клиент;
	ТабДок.Область("R4C1").Текст = "Склад отгрузки: " + Объект.СкладОтгрузки;
	ТабДок.Область("R6C1").Текст = "Товар"; ТабДок.Область("R6C2").Текст = "Кол-во";
	ТабДок.Область("R6C3").Текст = "Цена"; ТабДок.Область("R6C4").Текст = "Сумма";
	ТабДок.Область("R6C1:R6C4").Шрифт = Новый Шрифт(, 10, Истина);
	ТабДок.Область("R6C1:R6C4").ЦветФона = WebЦвета.СветлоСерый;
	НомерСтроки = 7;
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		ТабДок.Область("R" + НомерСтроки + "C1").Текст = СтрокаТЧ.Номенклатура;
		ТабДок.Область("R" + НомерСтроки + "C2").Текст = СтрокаТЧ.Количество;
		ТабДок.Область("R" + НомерСтроки + "C3").Текст = СтрокаТЧ.Цена;
		ТабДок.Область("R" + НомерСтроки + "C4").Текст = СтрокаТЧ.Сумма;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	НомерСтроки = НомерСтроки + 1;
	ТабДок.Область("R" + НомерСтроки + "C1").Текст = "Итого:";
	ТабДок.Область("R" + НомерСтроки + "C4").Текст = Объект.ИтоговаяСумма;
	Возврат ТабДок;
КонецФункции

&НаКлиенте
Процедура ТоварыПартияНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		Предупреждение("Сначала выберите Номенклатуру!"); Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.СкладОтгрузки) Тогда
		Предупреждение("Сначала выберите Склад отгрузки!"); Возврат;
	КонецЕсли;
	
	МассивПартий = ПолучитьПартииДляВыбора(Объект.СкладОтгрузки, ТекущаяСтрока.Номенклатура);
	Если МассивПартий.Количество() = 0 Тогда
		Предупреждение("На складе отгрузки нет остатков для этого товара!"); Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Ссылка", МассивПартий);
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПартииТовары", ЭтотОбъект);
	ОткрытьФорму("Документ.Расш1_Производственный_Выпуск.ФормаВыбора", Новый Структура("Отбор", Отбор), ЭтаФорма, , , , Оповещение);
КонецПроцедуры
