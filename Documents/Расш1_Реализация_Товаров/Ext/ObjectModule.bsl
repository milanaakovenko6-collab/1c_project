Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	//че-то правим...
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	//Делаем задачу 1.
	ТаблицаТребований = Новый ТаблицаЗначений;
	ТаблицаТребований.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Расш1_Номенклатура"));
	ТаблицаТребований.Колонки.Добавить("Требуется", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	//Делаем задачу 2...
	Для Каждого СтрокаТЧ Из Товары Цикл
		Если СтрокаТЧ.Количество > 0 Тогда
			Нов = ТаблицаТребований.Добавить();
			Нов.Номенклатура = СтрокаТЧ.Номенклатура;
			Нов.Требуется = СтрокаТЧ.Количество;
		КонецЕсли;
	КонецЦикла;
	//сделаем по красоте.
	ТаблицаТребований.Свернуть("Номенклатура", "Требуется");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Требования.Номенклатура КАК Номенклатура,
		|	Требования.Требуется КАК Требуется
		|ПОМЕСТИТЬ ВТ_ТоварыДокумента
		|ИЗ
		|	&ТаблицаТребований КАК Требования
		|
		|ВЫБРАТЬ 
		|	Остатки.Номенклатура КАК Номенклатура,
		|	Остатки.Партия КАК Партия,
		|	Остатки.КоличествоОстаток КАК Количество,
		|	ВЫБОР 
		|		КОГДА Остатки.Партия ССЫЛКА Документ.Расш1_Приход_Товара 
		|			ТОГДА ПриходТовары.Цена
		|		КОГДА Остатки.Партия ССЫЛКА Документ.Расш1_Производственный_Выпуск 
		|			ТОГДА ВЫБОР 
		|				КОГДА ВыпускПродукция.Количество > 0 ТОГДА ВыпускПродукция.Себестоимость / ВыпускПродукция.Количество
		|				ИНАЧЕ 0 КОНЕЦ
		|		ИНАЧЕ 0 
		|	КОНЕЦ КАК СебестоимостьЕд,
		|	ВЫБОР 
		|		КОГДА Остатки.Партия ССЫЛКА Документ.Расш1_Приход_Товара ТОГДА ПриходДок.Дата
		|		КОГДА Остатки.Партия ССЫЛКА Документ.Расш1_Производственный_Выпуск ТОГДА ВыпускДок.Дата
		|		ИНАЧЕ ДАТАВРЕМЯ(1,1,1)
		|	КОНЕЦ КАК ДатаПартии
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	РегистрНакопления.Расш1_Остатки_товаров.Остатки(&МоментВремени, Склад = &СкладОтгрузки) КАК Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Расш1_Приход_Товара.Материалы КАК ПриходТовары
		|		ПО Остатки.Партия = ПриходТовары.Ссылка И Остатки.Номенклатура = ПриходТовары.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Расш1_Производственный_Выпуск.Продукция КАК ВыпускПродукция
		|		ПО Остатки.Партия = ВыпускПродукция.Ссылка И Остатки.Номенклатура = ВыпускПродукция.Номенклатура
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Расш1_Приход_Товара КАК ПриходДок
		|		ПО Остатки.Партия = ПриходДок.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Расш1_Производственный_Выпуск КАК ВыпускДок
		|		ПО Остатки.Партия = ВыпускДок.Ссылка
		|ГДЕ 
		|	Остатки.Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ВТ_ТоварыДокумента)
		|	И Остатки.КоличествоОстаток > 0
		|;
		|
		|ВЫБРАТЬ 
		|	ВТ.Номенклатура КАК Номенклатура,
		|	Спр.Наименование КАК ИмяТовара,
		|	ВТ.Требуется,
		|	ЕСТЬNULL(СУММА(Ост.Количество), 0) КАК ОбщийОстаток,
		|	ВЫБОР
		|		КОГДА ВТ.Требуется > ЕСТЬNULL(СУММА(Ост.Количество), 0)
		|			ТОГДА ВТ.Требуется - ЕСТЬNULL(СУММА(Ост.Количество), 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Недостаток
		|ИЗ 
		|	ВТ_ТоварыДокумента КАК ВТ 
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Расш1_Номенклатура КАК Спр
		|		ПО ВТ.Номенклатура = Спр.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК Ост
		|		ПО ВТ.Номенклатура = Ост.Номенклатура
		|СГРУППИРОВАТЬ ПО 
		|	ВТ.Номенклатура,
		|	Спр.Наименование,
		|	ВТ.Требуется
		|ИМЕЮЩИЕ
		|	ВТ.Требуется > ЕСТЬNULL(СУММА(Ост.Количество), 0)
		|;
		|
		|ВЫБРАТЬ
		|	Номенклатура,
		|	Партия,
		|	Количество,
		|	СебестоимостьЕд
		|ИЗ
		|	ВТ_Остатки
		|УПОРЯДОЧИТЬ ПО 
		|	ДатаПартии ВОЗР
		|;
		|
		|ВЫБРАТЬ
		|	Номенклатура,
		|	Требуется
		|ИЗ
		|	ВТ_ТоварыДокумента";
	
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("СкладОтгрузки", СкладОтгрузки);
	Запрос.УстановитьПараметр("ТаблицаТребований", ТаблицаТребований);
	
	РезультатПакета = Запрос.ВыполнитьПакет();
	
	НовыеСтроки = Новый ТаблицаЗначений;
	НовыеСтроки.Колонки.Добавить("Номенклатура");
	НовыеСтроки.Колонки.Добавить("Партия");
	НовыеСтроки.Колонки.Добавить("Количество");
	НовыеСтроки.Колонки.Добавить("Цена");
	НовыеСтроки.Колонки.Добавить("Сумма");
	
	ТаблицаОстатков = РезультатПакета[3].Выгрузить();
	ВыборкаТребований = РезультатПакета[4].Выбрать();
	
	Пока ВыборкаТребований.Следующий() Цикл
		Требуется = ВыборкаТребований.Требуется;
		Отбор = Новый Структура("Номенклатура", ВыборкаТребований.Номенклатура);
		Партии = ТаблицаОстатков.НайтиСтроки(Отбор);
		
		Для Каждого СтрокаПартии Из Партии Цикл
			Если Требуется <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Взять = Мин(СтрокаПартии.Количество, Требуется);
			Нов = НовыеСтроки.Добавить();
			Нов.Номенклатура = ВыборкаТребований.Номенклатура;
			Нов.Партия = СтрокаПартии.Партия;
			Нов.Количество = Взять;
			Нов.Цена = Окр(СтрокаПартии.СебестоимостьЕд * 1.2, 2);
			Нов.Сумма = Взять * Нов.Цена;
			Требуется = Требуется - Взять;
		КонецЦикла;
	КонецЦикла;
	
	Товары.Очистить();
	Итог = 0;
	Для Каждого Нов Из НовыеСтроки Цикл
		Стр = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Нов);
		Итог = Итог + Стр.Сумма;
	КонецЦикла;
	ИтоговаяСумма = Итог;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.Расш1_Остатки_товаров.Записывать = Истина;
	Движения.Расш1_Продажи.Записывать = Истина;
	Движения.Расш1_Движения_Товаров.Записывать = Истина;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		Дв = Движения.Расш1_Остатки_товаров.Добавить();
		Дв.ВидДвижения = ВидДвиженияНакопления.Расход;
		Дв.Период = Дата;
		Дв.Номенклатура = СтрокаТЧ.Номенклатура;
		Дв.Склад = СкладОтгрузки;
		Дв.Партия = СтрокаТЧ.Партия;
		Дв.Количество = СтрокаТЧ.Количество;
		
		ДвП = Движения.Расш1_Продажи.Добавить();
		ДвП.Период = Дата;
		ДвП.Номенклатура = СтрокаТЧ.Номенклатура;
		ДвП.Контрагент = Клиент;
		ДвП.Склад = СкладОтгрузки;
		ДвП.Количество = СтрокаТЧ.Количество;
		ДвП.Сумма = СтрокаТЧ.Сумма;
		
		ДвТ = Движения.Расш1_Движения_Товаров.Добавить();
		ДвТ.Период = Дата;
		ДвТ.Номенклатура = СтрокаТЧ.Номенклатура;
		ДвТ.Склад = СкладОтгрузки;
		ДвТ.Операция = Перечисления.Расш1_Виды_Операций.Реализация;
		ДвТ.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	Движения.Записать();
КонецПроцедуры