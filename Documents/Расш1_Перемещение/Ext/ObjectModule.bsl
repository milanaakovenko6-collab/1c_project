Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.Расш1_Остатки_товаров.Записывать = Истина;
	Движения.Расш1_Движения_Товаров.Записывать = Истина;
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		// РАСХОД с отправителя
		ДвижениеРасход = Движения.Расш1_Остатки_товаров.Добавить();
		ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеРасход.Период = Дата;
		ДвижениеРасход.Номенклатура = СтрокаТЧ.Номенклатура;
		ДвижениеРасход.Склад = СкладОтправитель;
		ДвижениеРасход.Партия = СтрокаТЧ.Партия;
		ДвижениеРасход.Количество = СтрокаТЧ.Количество;
		
		// ПРИХОД на получателя
		ДвижениеПриход = Движения.Расш1_Остатки_товаров.Добавить();
		ДвижениеПриход.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеПриход.Период = Дата;
		ДвижениеПриход.Номенклатура = СтрокаТЧ.Номенклатура;
		ДвижениеПриход.Склад = СкладПолучатель;
		ДвижениеПриход.Партия = СтрокаТЧ.Партия;
		ДвижениеПриход.Количество = СтрокаТЧ.Количество;
		
		ДвижениеТоваров = Движения.Расш1_Движения_Товаров.Добавить();
		ДвижениеТоваров.Период = Дата;
		ДвижениеТоваров.Номенклатура = СтрокаТЧ.Номенклатура;
		ДвижениеТоваров.Склад = СкладПолучатель;
		ДвижениеТоваров.Операция = Перечисления.Расш1_Виды_Операций.Перемещение;
		ДвижениеТоваров.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	Движения.Записать();
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Если склад не выбран, ничего не делаем
	Если НЕ ЗначениеЗаполнено(СкладОтправитель) Тогда
		Возврат;
	КонецЕсли;
	
	// Создаем временную таблицу для новых строк
	НовыеСтроки = Новый ТаблицаЗначений;
	НовыеСтроки.Колонки.Добавить("Номенклатура");
	НовыеСтроки.Колонки.Добавить("Партия");
	НовыеСтроки.Колонки.Добавить("Количество");
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		Требуется = СтрокаТЧ.Количество;
		Если Требуется <= 0 Тогда Продолжить; КонецЕсли;
		
		// Ищем остатки на складе-отправителе (Цех экструзии)
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Остатки.Партия КАК Партия,
			|	Остатки.КоличествоОстаток КАК Остаток
			|ИЗ
			|	РегистрНакопления.Расш1_Остатки_товаров.Остатки(
			|		,
			|		Склад = &Склад
			|			И Номенклатура = &Номенклатура
			|	) КАК Остатки
			|ГДЕ
			|	Остатки.КоличествоОстаток > 0
			|УПОРЯДОЧИТЬ ПО
			|	Остатки.Партия.Дата ВОЗР";
			
		Запрос.УстановитьПараметр("Склад", СкладОтправитель);
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() И Требуется > 0 Цикл
			Взять = Мин(Выборка.Остаток, Требуется);
			
			Нов = НовыеСтроки.Добавить();
			Нов.Номенклатура = СтрокаТЧ.Номенклатура;
			Нов.Партия = Выборка.Партия; // Вот тут подставляется партия из Выпуска или Прихода
			Нов.Количество = Взять;
			
			Требуется = Требуется - Взять;
		КонецЦикла;
		
		// Если не хватило остатков
		Если Требуется > 0 Тогда
			Сообщить("Недостаточно товара " + СтрокаТЧ.Номенклатура + " на складе " + СкладОтправитель + "! Не хватает: " + Требуется);
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// Заменяем старую табличную часть на новую, где партии уже подставлены
	Товары.Очистить();
	Для Каждого Нов Из НовыеСтроки Цикл
		Стр = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Нов);
	КонецЦикла;
	
КонецПроцедуры