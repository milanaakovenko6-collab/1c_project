Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.Расш1_Остатки_товаров.Записывать = Истина;
	Движения.Расш1_Движения_Товаров.Записывать = Истина;
	
	// Проверь, как называется ТЧ на самом деле! Если "Товары" - оставляй.
	Для Каждого СтрокаТЧ Из Товары Цикл 
		// Расход из цеха
		ДвР = Движения.Расш1_Остатки_товаров.Добавить();
		ДвР.ВидДвижения = ВидДвиженияНакопления.Расход; 
		ДвР.Период = Дата;
		ДвР.Номенклатура = СтрокаТЧ.Номенклатура; 
		ДвР.Склад = ЦехОтправитель; 
		ДвР.Партия = СтрокаТЧ.Партия; 
		ДвР.Количество = СтрокаТЧ.Количество;
		
		// Приход на склад
		ДвП = Движения.Расш1_Остатки_товаров.Добавить();
		ДвП.ВидДвижения = ВидДвиженияНакопления.Приход; 
		ДвП.Период = Дата;
		ДвП.Номенклатура = СтрокаТЧ.Номенклатура; 
		ДвП.Склад = СкладХранения; 
		ДвП.Партия = СтрокаТЧ.Партия; 
		ДвП.Количество = СтрокаТЧ.Количество;
		
		ДвТ = Движения.Расш1_Движения_Товаров.Добавить();
		ДвТ.Период = Дата; 
		ДвТ.Номенклатура = СтрокаТЧ.Номенклатура; 
		ДвТ.Склад = СкладХранения; 
		ДвТ.Операция = Перечисления.Расш1_Виды_Операций.Перемещение; 
		ДвТ.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	Движения.Записать();
КонецПроцедуры 

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	РаспределитьПартииПоФИФО("Товары", "ЦехОтправитель", Отказ);
КонецПроцедуры

Процедура РаспределитьПартииПоФИФО(ИмяТЧ, ИмяСклада, Отказ)
	ТЧ = ЭтотОбъект[ИмяТЧ];
	Склад = ЭтотОбъект[ИмяСклада];
	
	Если НЕ ЗначениеЗаполнено(Склад) Тогда Возврат; КонецЕсли;
	
	// Создаем временную таблицу для новых строк
	НовыеСтроки = Новый ТаблицаЗначений;
	НовыеСтроки.Колонки.Добавить("Номенклатура");
	НовыеСтроки.Колонки.Добавить("Партия");
	НовыеСтроки.Колонки.Добавить("Количество");
	// Если есть цена/сумма, их нужно будет добавить сюда же
	
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		Требуется = СтрокаТЧ.Количество;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	Остатки.Партия КАК Партия,
			|	Остатки.КоличествоОстаток КАК Остаток
			|ИЗ
			|	РегистрНакопления.Расш1_Остатки_товаров.Остатки(, Склад = &Склад И Номенклатура = &Ном) КАК Остатки
			|ГДЕ
			|	Остатки.КоличествоОстаток > 0
			|УПОРЯДОЧИТЬ ПО
			|	Остатки.Партия.Дата ВОЗР";
		Запрос.УстановитьПараметр("Склад", Склад);
		Запрос.УстановитьПараметр("Ном", СтрокаТЧ.Номенклатура);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() И Требуется > 0 Цикл
			Взять = Мин(Выборка.Остаток, Требуется);
			
			Нов = НовыеСтроки.Добавить();
			Нов.Номенклатура = СтрокаТЧ.Номенклатура;
			Нов.Партия = Выборка.Партия;
			Нов.Количество = Взять;
			
			Требуется = Требуется - Взять;
		КонецЦикла;
		
		Если Требуется > 0 Тогда
			Сообщить("Недостаточно товара " + СтрокаТЧ.Номенклатура + " на складе!");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// Заменяем старую ТЧ на новую
	ТЧ.Очистить();
	Для Каждого Нов Из НовыеСтроки Цикл
		Стр = ТЧ.Добавить();
		ЗаполнитьЗначенияСвойств(Стр, Нов);
	КонецЦикла;
КонецПроцедуры 

