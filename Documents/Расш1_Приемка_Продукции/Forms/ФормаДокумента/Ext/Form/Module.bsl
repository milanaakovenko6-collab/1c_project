// ==========================================
// ФИЛЬТР НОМЕНКЛАТУРЫ (только Готовая продукция)
// ==========================================
&НаКлиенте
Процедура ТоварыНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораНоменклатурыГП", ЭтотОбъект);
	ПараметрыФормы = Новый Структура("Отбор", ПолучитьОтборПоГП());
	ОткрытьФорму("Справочник.Расш1_Номенклатура.ФормаВыбора", ПараметрыФормы, ЭтаФорма, , , , Оповещение);
КонецПроцедуры

&НаСервере
Функция ПолучитьОтборПоГП()
	Отбор = Новый Структура;
	СписокВидов = Новый Массив;
	СписокВидов.Добавить(Перечисления.Расш1_Виды_Номенклатуры.ГотоваяПродукция);
	Отбор.Вставить("Вид", СписокВидов);
	Возврат Отбор;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораНоменклатурыГП(ВыбранныйТовар, ДопПараметры) Экспорт
	Если ВыбранныйТовар <> Неопределено Тогда
		Строка = Элементы.Товары.ТекущиеДанные;
		Если Строка <> Неопределено Тогда
			Строка.Номенклатура = ВыбранныйТовар;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ==========================================
// ФИЛЬТР ПАРТИИ (только доступные в цехе)
// ==========================================
&НаКлиенте
Процедура ТоварыПартияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда
		Предупреждение("Сначала выберите Номенклатуру!");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ЦехОтправитель) Тогда
		Предупреждение("Сначала выберите Цех-отправитель в шапке!");
		Возврат;
	КонецЕсли;
	
	МассивПартий = ПолучитьПартииДляВыбора(Объект.ЦехОтправитель, ТекущаяСтрока.Номенклатура);
	Если МассивПартий.Количество() = 0 Тогда
		Предупреждение("В цехе нет остатков для этого товара!");
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Ссылка", МассивПартий);
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораПартииТовары", ЭтотОбъект);
	ОткрытьФорму("Документ.Расш1_Производственный_Выпуск.ФормаВыбора", Новый Структура("Отбор", Отбор), ЭтаФорма, , , , Оповещение);
КонецПроцедуры

&НаСервере
Функция ПолучитьПартииДляВыбора(Склад, Номенклатура)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Остатки.Партия КАК Партия
		|ИЗ РегистрНакопления.Расш1_Остатки_товаров.Остатки(, Склад = &Склад И Номенклатура = &Ном) КАК Остатки
		|ГДЕ Остатки.КоличествоОстаток > 0";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Ном", Номенклатура);
	
	Массив = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Выборка.Партия);
	КонецЦикла;
	Возврат Массив;
КонецФункции

&НаКлиенте
Процедура ПослеВыбораПартииТовары(ВыбраннаяПартия, ДопПараметры) Экспорт
	Если ВыбраннаяПартия <> Неопределено Тогда
		Строка = Элементы.Товары.ТекущиеДанные;
		Если Строка <> Неопределено Тогда
			Строка.Партия = ВыбраннаяПартия;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// ==========================================
// ПЕЧАТЬ
// ==========================================
&НаКлиенте
Процедура Печать(Команда)
	ТабДок = СформироватьПечатьНаСервере();
	ТабДок.Показать("Приходная накладная");
КонецПроцедуры

&НаСервере
Функция СформироватьПечатьНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОтображатьСетку = Истина;
	
	ТабДок.Область("C1").ШиринаКолонки = 30;
	ТабДок.Область("C2").ШиринаКолонки = 15;
	
	ТабДок.Область("R1C1:R1C2").Объединить();
	ТабДок.Область("R1C1").Текст = "Приемка продукции № " + Объект.Номер;
	ТабДок.Область("R1C1").Шрифт = Новый Шрифт(, 12, Истина);
	
	ТабДок.Область("R2C1").Текст = "Дата: " + Формат(Объект.Дата, "ДЛФ=DD");
	ТабДок.Область("R3C1").Текст = "Из цеха: " + Объект.ЦехОтправитель;
	ТабДок.Область("R4C1").Текст = "На склад: " + Объект.СкладХранения;
	
	ТабДок.Область("R6C1").Текст = "Товар";
	ТабДок.Область("R6C2").Текст = "Кол-во";
	ТабДок.Область("R6C1:R6C2").Шрифт = Новый Шрифт(, 10, Истина);
	ТабДок.Область("R6C1:R6C2").ЦветФона = WebЦвета.СветлоСерый;
	
	НомерСтроки = 7;
	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		ТабДок.Область("R" + НомерСтроки + "C1").Текст = СтрокаТЧ.Номенклатура;
		ТабДок.Область("R" + НомерСтроки + "C2").Текст = СтрокаТЧ.Количество;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат ТабДок;
КонецФункции  
