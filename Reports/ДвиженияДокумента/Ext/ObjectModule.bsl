&Вместо("ПередЗагрузкойНастроекВКомпоновщик")
Процедура Расш1_ПередЗагрузкойНастроекВКомпоновщик(ФормаОтчета, КлючСхемы, КлючВарианта, НастройкиОтчета, ПараметрыВыполнения) Экспорт
    
    Попытка
        // Пытаемся выполнить типовую логику (которая выкидывает исключение)
        ПродолжитьВызов(ФормаОтчета, КлючСхемы, КлючВарианта, НастройкиОтчета, ПараметрыВыполнения);
    Исключение
        // Если это наш документ - просто игнорируем ошибку "возможно открыть только из формы документа"
        Документ = Неопределено;
        Если НастройкиОтчета.Параметры.Найти("Документ") <> Неопределено Тогда
            Документ = НастройкиОтчета.Параметры.Документ.Значение;
        КонецЕсли;
        
        Если НЕ (ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Приход_Товара") 
            ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Производственный_Выпуск")
            ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Перемещение")
            ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Приемка_Продукции")
            ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Реализация_Товаров")) Тогда
            // Если это не наш документ, пробрасываем ошибку дальше
            ВызватьИсключение ОписаниеОшибки();
        КонецЕсли;
    КонецПопытки;
    
КонецПроцедуры