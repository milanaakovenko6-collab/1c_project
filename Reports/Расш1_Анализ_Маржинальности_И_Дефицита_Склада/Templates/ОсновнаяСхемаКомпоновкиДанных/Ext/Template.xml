		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>Рентабельность</dataPath>
		<expression>Формат(
    ВЫБОР 
        КОГДА Выручка = 0 ТОГДА 0 
        ИНАЧЕ ((Выручка - Себестоимость) / Выручка) * 100 
    КОНЕЦ, 
    "ЧДЦ=2; ЧН=0"
)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Рентабельность</v8:content>
			</v8:item>
		</title>
	</calculatedField>
