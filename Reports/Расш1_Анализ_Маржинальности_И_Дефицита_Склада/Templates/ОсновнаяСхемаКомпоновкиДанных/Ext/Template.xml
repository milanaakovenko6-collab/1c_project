		<dataPath>ВаловаяПрибыль</dataPath>
		<expression>Выручка - Себестоимость</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Валовая прибыль</v8:content>
