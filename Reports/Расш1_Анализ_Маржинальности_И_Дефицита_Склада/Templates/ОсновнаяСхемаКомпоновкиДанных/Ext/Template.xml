		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Остатки.Склад КАК Склад,
	Остатки.Номенклатура КАК Номенклатура,
	Остатки.КоличествоОстаток КАК ТекущийОстаток
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрНакопления.Расш1_Остатки_товаров.Остатки(
		&amp;КонецПериода,
		Склад = &amp;Склад ИЛИ &amp;Склад = НЕОПРЕДЕЛЕНО
	) КАК Остатки
;

ВЫБРАТЬ
	Продажи.Склад КАК Склад,
	Продажи.Номенклатура КАК Номенклатура,
	СУММА(Продажи.КоличествоОборот) КАК Продано,
	СУММА(Продажи.СуммаОборот) КАК Выручка
ПОМЕСТИТЬ ВТ_Продажи
ИЗ
	РегистрНакопления.Расш1_Продажи.Обороты(
		&amp;НачалоПериода, 
		&amp;КонецПериода, 
		Регистратор, 
		Склад = &amp;Склад ИЛИ &amp;Склад = НЕОПРЕДЕЛЕНО
	) КАК Продажи
СГРУППИРОВАТЬ ПО
	Продажи.Склад,
	Продажи.Номенклатура
;

ВЫБРАТЬ
	ДокРеализация.СкладОтгрузки КАК Склад,
	ТоварыРеализация.Номенклатура КАК Номенклатура,
	СУММА(ТоварыРеализация.Количество * ВЫБОР
		КОГДА Приход.Ссылка &lt;&gt; НЕОПРЕДЕЛЕНО ТОГДА Приход.Цена
		КОГДА Выпуск.Ссылка &lt;&gt; НЕОПРЕДЕЛЕНО ТОГДА ВЫБОР
			КОГДА Выпуск.Количество &gt; 0 ТОГДА Выпуск.Себестоимость / Выпуск.Количество
			ИНАЧЕ 0 КОНЕЦ
		ИНАЧЕ 0
	КОНЕЦ) КАК Себестоимость
ПОМЕСТИТЬ ВТ_Себестоимость
ИЗ
	Документ.Расш1_Реализация_Товаров КАК ДокРеализация
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Расш1_Реализация_Товаров.Товары КАК ТоварыРеализация
		ПО ДокРеализация.Ссылка = ТоварыРеализация.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Расш1_Приход_Товара.Материалы КАК Приход
		ПО ТоварыРеализация.Партия = Приход.Ссылка И ТоварыРеализация.Номенклатура = Приход.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.Расш1_Производственный_Выпуск.Продукция КАК Выпуск
		ПО ТоварыРеализация.Партия = Выпуск.Ссылка И ТоварыРеализация.Номенклатура = Выпуск.Номенклатура
ГДЕ
	ДокРеализация.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
СГРУППИРОВАТЬ ПО
	ДокРеализация.СкладОтгрузки,
	ТоварыРеализация.Номенклатура
;

ВЫБРАТЬ
	Спр.Ссылка КАК Номенклатура,
	Спр.Наименование КАК ИмяНоменклатуры,
	Спр.ОсновнойПоставщик КАК ОсновнойПоставщик,
	Спр.МинимальныйОстаток КАК МинимальныйОстаток,
	ВТ_Остатки.Склад КАК Склад,
	ЕСТЬNULL(ВТ_Остатки.ТекущийОстаток, 0) КАК ТекущийОстаток,
	ЕСТЬNULL(ВТ_Продажи.Продано, 0) КАК Продано,
	ЕСТЬNULL(ВТ_Продажи.Выручка, 0) КАК Выручка,
	ЕСТЬNULL(ВТ_Себестоимость.Себестоимость, 0) КАК Себестоимость
ИЗ
	Справочник.Расш1_Номенклатура КАК Спр
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
		ПО Спр.Ссылка = ВТ_Остатки.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Продажи КАК ВТ_Продажи
		ПО Спр.Ссылка = ВТ_Продажи.Номенклатура И ВТ_Остатки.Склад = ВТ_Продажи.Склад
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Себестоимость КАК ВТ_Себестоимость
		ПО Спр.Ссылка = ВТ_Себестоимость.Номенклатура И ВТ_Остатки.Склад = ВТ_Себестоимость.Склад
ГДЕ
	(Спр.ОсновнойПоставщик = &amp;ОсновнойПоставщик ИЛИ &amp;ОсновнойПоставщик = НЕОПРЕДЕЛЕНО)</query>
