&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Документ") И ЗначениеЗаполнено(Параметры.Документ) Тогда
		
		// 1. Очищаем старые настройки, чтобы старый документ не прилипал
		Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Очистить();
		
		// 2. Ищем параметр в настройках по умолчанию
		Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
		
		// Если параметр не создан, создаем принудительно
		Параметр = Настройки.Параметры.Найти("Документ");
		Если Параметр = Неопределено Тогда
			Параметр = Настройки.Параметры.Добавить("Документ");
		КонецЕсли;
		
		// 3. Устанавливаем значение и включаем
		Параметр.Значение = Параметры.Документ;
		Параметр.Использование = Истина;
		
		// 4. Загружаем измененные настройки обратно
		Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
		
	КонецЕсли;
	
КонецПроцедуры