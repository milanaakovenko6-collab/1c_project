		<query>// ==========================================
// 1. ПРЯМЫЕ СВЯЗИ (Где текущий документ выступает как Партия)
// ==========================================
ВЫБРАТЬ РАЗЛИЧНЫЕ
	"Перемещение" КАК ТипСвязи,
	Товары.Ссылка КАК Документ,
	Товары.Ссылка.Дата КАК Дата
ИЗ Документ.Расш1_Перемещение.Товары КАК Товары
ГДЕ Товары.Партия = &amp;Документ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	"Производственный выпуск" КАК ТипСвязи,
	Материалы.Ссылка КАК Документ,
	Материалы.Ссылка.Дата КАК Дата
ИЗ Документ.Расш1_Производственный_Выпуск.Материалы КАК Материалы
ГДЕ Материалы.Партия = &amp;Документ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	"Приемка продукции" КАК ТипСвязи,
	Товары.Ссылка КАК Документ,
	Товары.Ссылка.Дата КАК Дата
ИЗ Документ.Расш1_Приемка_Продукции.Товары КАК Товары
ГДЕ Товары.Партия = &amp;Документ

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	"Реализация" КАК ТипСвязи,
	Товары.Ссылка КАК Документ,
	Товары.Ссылка.Дата КАК Дата
ИЗ Документ.Расш1_Реализация_Товаров.Товары КАК Товары
ГДЕ Товары.Партия = &amp;Документ

ОБЪЕДИНИТЬ ВСЕ

// ==========================================
// 2. ОБРАТНЫЕ СВЯЗИ (Какие партии использует текущий документ)
// ==========================================
ВЫБРАТЬ РАЗЛИЧНЫЕ
	"Перемещение (использован Приход)" КАК ТипСвязи,
	Товары.Партия КАК Документ,
	Товары.Партия.Дата КАК Дата
ИЗ Документ.Расш1_Перемещение.Товары КАК Товары
ГДЕ Товары.Ссылка = &amp;Документ
	И Товары.Партия &lt;&gt; НЕОПРЕДЕЛЕНО

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	"Выпуск (использован Приход)" КАК ТипСвязи,
	Материалы.Партия КАК Документ,
	Материалы.Партия.Дата КАК Дата
ИЗ Документ.Расш1_Производственный_Выпуск.Материалы КАК Материалы
ГДЕ Материалы.Ссылка = &amp;Документ
	И Материалы.Партия &lt;&gt; НЕОПРЕДЕЛЕНО

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	"Приемка (использован Выпуск)" КАК ТипСвязи,
	Товары.Партия КАК Документ,
	Товары.Партия.Дата КАК Дата
ИЗ Документ.Расш1_Приемка_Продукции.Товары КАК Товары
ГДЕ Товары.Ссылка = &amp;Документ
	И Товары.Партия &lt;&gt; НЕОПРЕДЕЛЕНО

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	"Реализация (использован Выпуск)" КАК ТипСвязи,
