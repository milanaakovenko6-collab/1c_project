&НаКлиенте
Процедура ЗаполнитьПоДефициту(Команда)
	
	ЗаполнитьНаСервере();
	
	Если Товары.Количество() = 0 Тогда
		Предупреждение("Дефицита не обнаружено! Все товары на складах в норме.");
	Иначе
		Сообщить("Успешно добавлено строк с дефицитом: " + Товары.Количество());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	Товары.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Спр.Ссылка КАК Номенклатура,
		|	Спр.Вид КАК Вид,
		|	Спр.ОсновнойПоставщик КАК Поставщик,
		|	Спр.МинимальныйОстаток - ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК КоличествоКЗаказу
		|ИЗ
		|	Справочник.Расш1_Номенклатура КАК Спр
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Расш1_Остатки_товаров.Остатки(
		|			&ТекущаяДата 
		|		) КАК Остатки
		|		ПО Спр.Ссылка = Остатки.Номенклатура
		|ГДЕ
		|	Спр.МинимальныйОстаток > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)";
		
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Вид = Выборка.Вид; 
		НоваяСтрока.Поставщик = Выборка.Поставщик;
		НоваяСтрока.Количество = Выборка.КоличествоКЗаказу;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаказы(Команда)
	Если Товары.Количество() = 0 Тогда
		Предупреждение("Таблица пуста!");
		Возврат;
	КонецЕсли;
	
	Результат = СформироватьДокументыНаСервере();
	Сообщить("Создано Приходов (сырье): " + Результат.Приходы + Символы.ПС +
	               "Создано Выпусков (ГП): " + Результат.Выпуски);
КонецПроцедуры

&НаСервере
Функция СформироватьДокументыНаСервере()
	
	ТаблицаСырье = Новый ТаблицаЗначений;
	ТаблицаСырье.Колонки.Добавить("Поставщик");
	ТаблицаСырье.Колонки.Добавить("Номенклатура");
	ТаблицаСырье.Колонки.Добавить("Количество");

	ТаблицаГП = Новый ТаблицаЗначений;
	ТаблицаГП.Колонки.Добавить("Номенклатура");
	ТаблицаГП.Колонки.Добавить("Количество");
	
	Для Каждого Стр Из Товары Цикл
		Если Стр.Вид = Перечисления.Расш1_Виды_Номенклатуры.Сырье Тогда
			Нов = ТаблицаСырье.Добавить();
			Нов.Поставщик = Стр.Поставщик;
			Нов.Номенклатура = Стр.Номенклатура;
			Нов.Количество = Стр.Количество;
		ИначеЕсли Стр.Вид = Перечисления.Расш1_Виды_Номенклатуры.ГотоваяПродукция Тогда
			Нов = ТаблицаГП.Добавить();
			Нов.Номенклатура = Стр.Номенклатура;
			Нов.Количество = Стр.Количество;
		КонецЕсли;
	КонецЦикла;
	
	КолвоПриходов = 0;
	КолвоВыпусков = 0;
	
	Если ТаблицаСырье.Количество() > 0 Тогда
		ТаблицаСырье.Свернуть("Поставщик, Номенклатура", "Количество");
		
		МассивПоставщиков = Новый Массив;
		Для Каждого Стр Из ТаблицаСырье Цикл
			Если МассивПоставщиков.Найти(Стр.Поставщик) = Неопределено Тогда
				МассивПоставщиков.Добавить(Стр.Поставщик);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекущийПоставщик Из МассивПоставщиков Цикл

			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	Приход.Ссылка КАК Ссылка,
				|	ПриходТовары.Номенклатура КАК Номенклатура,
				|	ПриходТовары.Количество КАК Количество
				|ИЗ
				|	Документ.Расш1_Приход_Товара КАК Приход
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Расш1_Приход_Товара.Материалы КАК ПриходТовары
				|		ПО Приход.Ссылка = ПриходТовары.Ссылка
				|ГДЕ
				|	Приход.Проведен = ЛОЖЬ
				|	И НЕ Приход.ПометкаУдаления
				|	И Приход.Поставщик = &Поставщик";
			
			Запрос.УстановитьПараметр("Поставщик", ТекущийПоставщик);
			РезультатЗапроса = Запрос.Выполнить().Выгрузить();
			
			ЕстьДубль = Ложь;
			
			Для Каждого СтрНашейТаблицы Из ТаблицаСырье Цикл
				Если СтрНашейТаблицы.Поставщик = ТекущийПоставщик Тогда
					
					Отбор = Новый Структура("Номенклатура", СтрНашейТаблицы.Номенклатура);
					НайденныеСтроки = РезультатЗапроса.НайтиСтроки(Отбор);
					
					Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
						Если НайденнаяСтрока.Количество = СтрНашейТаблицы.Количество Тогда
							ЕстьДубль = Истина;
							Прервать; 
						КонецЕсли;
					КонецЦикла;
					
					Если ЕстьДубль Тогда
						Прервать; 
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если Не ЕстьДубль Тогда
				НовыйПриход = Документы.Расш1_Приход_Товара.СоздатьДокумент();
				НовыйПриход.Дата = ТекущаяДата();
				НовыйПриход.Поставщик = ТекущийПоставщик;
				НовыйПриход.Склад = Справочники.Расш1_Склады.НайтиПоНаименованию("Склад сырья");
				
				Для Каждого Стр Из ТаблицаСырье Цикл
					Если Стр.Поставщик = ТекущийПоставщик Тогда
						НоваяСтрока = НовыйПриход.Материалы.Добавить(); 
						НоваяСтрока.Номенклатура = Стр.Номенклатура;
						НоваяСтрока.Количество = Стр.Количество;
					КонецЕсли;
				КонецЦикла;
				
				Попытка
					НовыйПриход.Записать(РежимЗаписиДокумента.Запись);
					КолвоПриходов = КолвоПриходов + 1;
				Исключение
					Сообщить("Ошибка при записи прихода от " + ТекущийПоставщик + ": " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	

	Если ТаблицаГП.Количество() > 0 Тогда
		Для Каждого Стр Из ТаблицаГП Цикл
			
			ЗапросВыпуск = Новый Запрос;
			ЗапросВыпуск.Текст = 
				"ВЫБРАТЬ
				|	ВыпускТовары.Номенклатура КАК Номенклатура,
				|	ВыпускТовары.Количество КАК Количество
				|ИЗ
				|	Документ.Расш1_Производственный_Выпуск КАК Выпуск
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.Расш1_Производственный_Выпуск.Продукция КАК ВыпускТовары
				|		ПО Выпуск.Ссылка = ВыпускТовары.Ссылка
				|ГДЕ
				|	Выпуск.Проведен = ЛОЖЬ
				|	И НЕ Выпуск.ПометкаУдаления
				|	И Выпуск.Цех = &Цех";
			
			ЗапросВыпуск.УстановитьПараметр("Цех", Справочники.Расш1_Склады.НайтиПоНаименованию("Цех 1"));
			РезультатВыпуска = ЗапросВыпуск.Выполнить().Выгрузить();
			
			ЕстьДубльВыпуска = Ложь;
			ОтборВыпуск = Новый Структура("Номенклатура", Стр.Номенклатура);
			НайденныеСтрокиВыпуск = РезультатВыпуска.НайтиСтроки(ОтборВыпуск);
			
			Для Каждого НайденнаяСтрока Из НайденныеСтрокиВыпуск Цикл
				Если НайденнаяСтрока.Количество = Стр.Количество Тогда
					ЕстьДубльВыпуска = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Не ЕстьДубльВыпуска Тогда
				НовыйВыпуск = Документы.Расш1_Производственный_Выпуск.СоздатьДокумент();
				НовыйВыпуск.Дата = ТекущаяДата();
				НовыйВыпуск.Цех = Справочники.Расш1_Склады.НайтиПоНаименованию("Цех 1"); 
				
				НоваяСтрока = НовыйВыпуск.Продукция.Добавить();
				НоваяСтрока.Номенклатура = Стр.Номенклатура;
				НоваяСтрока.Количество = Стр.Количество;
				
				Попытка
					НовыйВыпуск.Записать(РежимЗаписиДокумента.Запись);
					КолвоВыпусков = КолвоВыпусков + 1;
				Исключение
					Сообщить("Ошибка при записи выпуска: " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Товары.Очистить();
	
	Возврат Новый Структура("Приходы, Выпуски", КолвоПриходов, КолвоВыпусков);
КонецФункции