&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
    
    Если НЕ ЗначениеЗаполнено(ПараметрКоманды) Тогда
        Предупреждение("Сначала запишите документ!");
        Возврат;
    КонецЕсли;
    
    // Формируем параметры для стандартной формы СвязанныеДокументы
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("ОбъектОтбора", ПараметрКоманды); // Стандартная форма ждет именно этот параметр
    
    // Вызываем стандартную общую форму ERP
    ОткрытьФорму("ОбщаяФорма.СвязанныеДокументы", 
        ПараметрыФормы, 
        ПараметрыВыполненияКоманды.Источник,
        ПараметрыВыполненияКоманды.Уникальность,
        ПараметрыВыполненияКоманды.Окно,
        ПараметрыВыполненияКоманды.НавигационнаяСсылка);
    
КонецПроцедуры