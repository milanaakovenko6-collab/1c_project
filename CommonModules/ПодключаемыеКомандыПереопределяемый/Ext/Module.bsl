&Вместо("ПриОпределенииКомандОтчетов")
Процедура Расш1_ПриОпределенииКомандОтчетов(КомандыОтчетов) Экспорт
    ПродолжитьВызов(КомандыОтчетов);
    
    // Добавляем команду "Движения документа" для наших документов
    Команда = КомандыОтчетов.Добавить();
    Команда.Идентификатор = "Расш1_ДвиженияДокумента";
    Команда.Представление = НСтр("ru = 'Движения документа'");
    Команда.Менеджер = "Отчет.ДвиженияДокумента";
    Команда.Типы = Новый ОписаниеТипов(
        "ДокументСсылка.Расш1_Приход_Товара,
        |ДокументСсылка.Расш1_Производственный_Выпуск,
        |ДокументСсылка.Расш1_Перемещение,
        |ДокументСсылка.Расш1_Приемка_Продукции,
        |ДокументСсылка.Расш1_Реализация_Товаров");
КонецПроцедуры 

&После("ПриОпределенииВидовПодключаемыхКоманд")
Процедура Расш1_ДобавитьВидКомандыОтчетов(ВидыПодключаемыхКоманд) Экспорт
    
    // Добавляем свой вид команды для отчетов
    Вид = ВидыПодключаемыхКоманд.Добавить();
    Вид.Имя = "Расш1_Отчеты";
    Вид.ИмяПодменю = "ПодменюОтчеты";
    Вид.Заголовок = НСтр("ru = 'Отчеты'");
    Вид.Порядок = 50;
    Вид.Картинка = БиблиотекаКартинок.Отчет;
    // Вот ключевая строка, которой не хватало:
    Вид.Отображение = ОтображениеКнопки.КартинкаИТекст;
    
КонецПроцедуры