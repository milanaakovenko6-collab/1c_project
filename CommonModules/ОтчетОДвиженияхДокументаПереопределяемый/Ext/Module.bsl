&Вместо("ПриОпределенииРегистровСДвижениями")
Процедура Расш1_ПриОпределенииРегистровСДвижениями(Документ, РегистрыСДвижениями) Экспорт
    ПродолжитьВызов(Документ, РегистрыСДвижениями);
    Если ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Приход_Товара")
        ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Производственный_Выпуск")
        ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Перемещение")
        ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Приемка_Продукции")
        ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.Расш1_Реализация_Товаров") Тогда
        РегистрыСДвижениями.Вставить(Метаданные.РегистрыНакопления.Расш1_Остатки_товаров, "Регистратор");
        РегистрыСДвижениями.Вставить(Метаданные.РегистрыНакопления.Расш1_Движения_Товаров, "Регистратор");
    КонецЕсли;
КонецПроцедуры